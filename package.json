{
  "name": "@mdit-vue/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run -r --stream build",
    "check-types": "tsc --noEmit --skipLibCheck",
    "clean": "pnpm run -r --stream clean",
    "dev": "vitest",
    "format": "oxfmt",
    "lint": "oxlint && oxfmt --check",
    "prepare": "husky",
    "release": "pnpm release:check && pnpm release:version",
    "release:check": "pnpm clean && pnpm build && pnpm check-types && pnpm lint && pnpm test",
    "release:version": "lerna version",
    "test": "vitest run"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:dev",
    "@commitlint/config-conventional": "catalog:dev",
    "@commitlint/types": "catalog:dev",
    "@lerna-lite/cli": "catalog:dev",
    "@lerna-lite/publish": "catalog:dev",
    "@meteorlxy/oxfmt-config": "catalog:dev",
    "@meteorlxy/oxlint-config": "catalog:dev",
    "@meteorlxy/tsconfig": "catalog:dev",
    "@types/node": "catalog:dev",
    "@vitest/coverage-istanbul": "catalog:dev",
    "husky": "catalog:dev",
    "lint-staged": "catalog:dev",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "rimraf": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "lint-staged": {
    "*.(js|ts)": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.!(js|ts)": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0"
    }
  }
}
